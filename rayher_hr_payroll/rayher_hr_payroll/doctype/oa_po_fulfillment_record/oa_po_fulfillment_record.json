    {"role":"Purchase User","read":1,"write":0,"create":0,"delete":0,"report":1,"export":1},
    {"role":"Accounts User","read":1,"write":0,"create":0,"delete":0,"report":1,"export":1},
    {"role":"Employee","read":1,"write":0,"create":0,"delete":0}
