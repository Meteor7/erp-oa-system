    {"fieldname":"details_json","fieldtype":"Long Text","label":"Material Details","reqd":1,"read_only":1},
    {"fieldname":"evidence_file","fieldtype":"Attach","label":"Evidence File","reqd":1,"read_only":1},
    {"fieldname":"original_filename","fieldtype":"Data","label":"Original Filename","reqd":1,"read_only":1},
