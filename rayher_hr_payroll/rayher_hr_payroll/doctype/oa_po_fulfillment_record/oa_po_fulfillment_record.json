    {"fieldname":"record_type","fieldtype":"Select","options":"到货\n验收","label":"Record Type","reqd":1,"read_only":1,"in_list_view":1},
    {"fieldname":"record_date","fieldtype":"Date","label":"Record Date","reqd":1,"read_only":1},
