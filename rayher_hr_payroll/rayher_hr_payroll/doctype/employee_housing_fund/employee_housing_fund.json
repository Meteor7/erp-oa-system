{
 "doctype": "DocType",
 "name": "Employee Housing Fund",
 "module": "Rayher HR Payroll",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "track_changes": 1,
 "autoname": "HF-.{period}.-.####",
 "title_field": "employee_name",
 "fields": [
  {
   "fieldname": "period",
   "label": "期间",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "employee",
   "label": "员工",
   "fieldtype": "Link",
   "options": "Employee",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "employee_name",
   "label": "员工姓名",
   "fieldtype": "Data",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "contribution_base",
   "label": "缴存基数",
   "fieldtype": "Currency",
   "reqd": 1
  },
  {
   "fieldname": "employee_rate",
   "label": "个人比例（%）",
   "fieldtype": "Percent"
  },
  {
   "fieldname": "company_rate",
   "label": "公司比例（%）",
   "fieldtype": "Percent"
  },
  {
   "fieldname": "employee_amount",
   "label": "个人缴存额",
   "fieldtype": "Currency",
   "read_only": 1
  },
  {
   "fieldname": "company_amount",
   "label": "公司缴存额",
   "fieldtype": "Currency",
   "read_only": 1
  },
  {
   "fieldname": "status",
   "label": "状态",
   "fieldtype": "Select",
   "options": "Draft\nConfirmed",
   "default": "Draft",
   "in_list_view": 1
  },
  {
   "fieldname": "remark",
   "label": "备注",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "employee_period_key",
   "label": "员工期间键",
   "fieldtype": "Data",
   "unique": 1,
   "hidden": 1,
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  },
  {
   "role": "HR Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  },
  {
   "role": "HR User",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1
  }
 ]
}
