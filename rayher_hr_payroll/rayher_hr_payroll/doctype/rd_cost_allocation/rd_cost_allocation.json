{
 "doctype": "DocType",
 "name": "RD Cost Allocation",
 "module": "Rayher HR Payroll",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 1,
 "editable_grid": 0,
 "track_changes": 1,
 "naming_rule": "Expression (old style)",
 "autoname": "ALLOC-.{period}.-.####",
 "title_field": "period",
 "fields": [
  {
   "fieldname": "period",
   "label": "期间",
   "fieldtype": "Data",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "year",
   "label": "年度",
   "fieldtype": "Int",
   "reqd": 1
  },
  {
   "fieldname": "month",
   "label": "月份",
   "fieldtype": "Int",
   "reqd": 1
  },
  {
   "fieldname": "expense_import",
   "label": "费用导入单",
   "fieldtype": "Link",
   "reqd": 1,
   "options": "RD Expense Import",
   "in_list_view": 1
  },
  {
   "fieldname": "allocation_basis",
   "label": "分摊依据",
   "fieldtype": "Select",
   "reqd": 1,
   "options": "rd_project_hours",
   "default": "rd_project_hours"
  },
  {
   "fieldname": "calculation_version",
   "label": "计算版本",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "scope",
   "label": "分摊范围",
   "fieldtype": "Select",
   "reqd": 1,
   "options": "all\ncapitalized\nexpensed",
   "default": "all",
   "read_only": 1
  },
  {
   "fieldname": "status",
   "label": "状态",
   "fieldtype": "Select",
   "reqd": 1,
   "options": "Draft\nCalculated\nSubmitted\nCancelled",
   "default": "Draft",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "capitalized_total",
   "label": "资本化合计",
   "fieldtype": "Currency",
   "reqd": 0,
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "expensed_total",
   "label": "费用化合计",
   "fieldtype": "Currency",
   "reqd": 0,
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "unknown_total",
   "label": "未判定阶段合计",
   "fieldtype": "Currency",
   "reqd": 0,
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "lines",
   "label": "分摊明细",
   "fieldtype": "Table",
   "reqd": 0,
   "options": "RD Cost Allocation Line",
   "read_only": 1
  },
  {
   "fieldname": "hour_snapshots",
   "label": "工时来源快照",
   "fieldtype": "Table",
   "reqd": 0,
   "options": "RD Allocation Source Hour",
   "read_only": 1
  },
  {
   "fieldname": "expense_snapshots",
   "label": "费用来源快照",
   "fieldtype": "Table",
   "reqd": 0,
   "options": "RD Allocation Source Expense",
   "read_only": 1
  }
 ],
