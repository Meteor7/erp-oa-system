{
 "doctype": "DocType",
 "name": "Housing Fund Import Batch",
 "module": "Rayher HR Payroll",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "track_changes": 1,
 "autoname": "HFB-.YYYY.-.#####",
 "title_field": "source_filename",
 "fields": [
  {
   "fieldname": "company",
   "label": "公司",
   "fieldtype": "Link",
   "options": "Company",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "period",
   "label": "期间",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "source_file",
   "label": "原始文件",
   "fieldtype": "Attach",
   "reqd": 1
  },
  {
   "fieldname": "source_filename",
   "label": "文件名",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "file_hash",
   "label": "文件哈希",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "batch_key",
   "label": "批次键",
   "fieldtype": "Data",
   "unique": 1,
   "hidden": 1,
   "read_only": 1
  },
  {
   "fieldname": "status",
   "label": "状态",
   "fieldtype": "Select",
   "options": "Parsing\nPending Activation\nCurrent\nHistorical\nCanceled\nFailed",
   "default": "Parsing",
   "in_list_view": 1
  },
  {
   "fieldname": "is_current",
   "label": "当前有效",
   "fieldtype": "Check",
   "default": "0",
   "in_list_view": 1
  },
  {
   "fieldname": "uploaded_by",
   "label": "上传人",
   "fieldtype": "Link",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "uploaded_at",
   "label": "上传时间",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "total_rows",
   "label": "总行数",
   "fieldtype": "Int",
   "read_only": 1
  },
  {
   "fieldname": "parsed_rows",
   "label": "成功解析数",
   "fieldtype": "Int",
   "read_only": 1
  },
  {
   "fieldname": "matched_rows",
   "label": "完全匹配数",
   "fieldtype": "Int",
   "read_only": 1
  },
  {
   "fieldname": "pending_rows",
   "label": "待确认数",
   "fieldtype": "Int",
   "read_only": 1
  },
  {
   "fieldname": "unlinked_rows",
   "label": "无法关联数",
   "fieldtype": "Int",
   "read_only": 1
  },
  {
   "fieldname": "missing_rows",
   "label": "申报表里没有的人数",
   "fieldtype": "Int",
   "read_only": 1
  },
  {
   "fieldname": "employee_total",
   "label": "个人合计",
   "fieldtype": "Currency",
   "read_only": 1
  },
  {
   "fieldname": "company_total",
   "label": "单位合计",
   "fieldtype": "Currency",
   "read_only": 1
  },
  {
   "fieldname": "receivable_total",
   "label": "应缴合计",
   "fieldtype": "Currency",
   "read_only": 1
  },
  {
   "fieldname": "cancel_remark",
   "label": "取消原因",
   "fieldtype": "Small Text",
   "read_only": 1
  },
  {
   "fieldname": "canceled_by",
   "label": "取消人",
   "fieldtype": "Link",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "canceled_at",
   "label": "取消时间",
   "fieldtype": "Datetime",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  },
  {
   "role": "HR Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  },
  {
   "role": "HR User",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1
  }
 ]
}
